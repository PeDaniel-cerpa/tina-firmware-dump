#!/bin/sh
# ==============================================================================
# debug1 v2 - ejecutado como root desde /mnt/extsd al arrancar
# Probado en pantallas Allwinner / Tina Linux (TF811, M750)
#
# - vuelca el firmware completo a la SD
# - levanta telnetd (BusyBox estatico) en el puerto 23 si existe busybox_net
#
# IMPORTANTE:
#   - nombre exacto "debug1" (sin extension), en la RAIZ de la SD
#   - saltos de linea LF (UNIX), no CRLF
#   - se ejecuta de forma sincronica desde /etc/init.d/S01app:
#     cualquier servicio de red debe lanzarse en segundo plano (&)
# ==============================================================================

LOG=/mnt/extsd/debug1.log
DUMP=/mnt/extsd/firmware_dump

log() { echo "[debug1] $*" >> "$LOG" 2>/dev/null; }

: > "$LOG"
log "=== INICIO $(date) ==="

mkdir -p "$DUMP" 2>/dev/null

# --- 1) Informacion del sistema -----------------------------------------------
# Aqui se ve la IP real del equipo (seccion ifconfig) si el DHCP no dio .1
{
    echo "FECHA: $(date)"
    echo "CMDLINE: $(cat /proc/cmdline 2>/dev/null)"
    echo "--- /proc/mtd ---";   cat /proc/mtd 2>/dev/null
    echo "--- partitions ---";  cat /proc/partitions 2>/dev/null
    echo "--- mounts ---";      cat /proc/mounts 2>/dev/null
    echo "--- ifconfig ---";    ifconfig 2>/dev/null
    echo "--- route ---";       route -n 2>/dev/null
} > "$DUMP/info.txt" 2>&1
log "info.txt listo"

# --- 2) Volcar todas las particiones MTD --------------------------------------
for m in /dev/mtdblock*; do
    [ -e "$m" ] || continue
    n=${m##*/}
    log "volcando $m"
    dd if="$m" of="$DUMP/$n.bin" bs=64k >> "$LOG" 2>&1
done

# --- 3) Copiar configuracion --------------------------------------------------
# -L dereferencia symlinks: FAT32 no puede crearlos (Operation not permitted)
for d in /etc /overlay /data; do
    [ -d "$d" ] || continue
    n=${d##*/}
    mkdir -p "$DUMP/$n" 2>/dev/null
    log "copiando $d"
    cp -RpL "$d"/. "$DUMP/$n/" >> "$LOG" 2>&1
done

# --- 4) Shell root por IP -----------------------------------------------------
# BusyBox estatico: sin dependencias de la musl del firmware.
# -l /bin/sh entra directo como root, sin password.
# & -> no bloquea el arranque (S01app espera a que este script termine).
if [ -x /mnt/extsd/busybox_net ]; then
    /mnt/extsd/busybox_net telnetd -p 23 -l /bin/sh >> "$LOG" 2>&1 &
    sleep 1
    if pidof busybox_net >/dev/null 2>&1 || ps | grep -q '[t]elnetd'; then
        log "telnetd ACTIVO en puerto 23 -> Tera Term: 192.168.10.1:23"
    else
        log "telnetd no quedo activo; ver errores arriba"
    fi
else
    log "AVISO: no existe /mnt/extsd/busybox_net -> sin shell por IP"
fi

log "=== FIN $(date) ==="
exit 0
